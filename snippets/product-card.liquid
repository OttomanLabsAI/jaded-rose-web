{%- comment -%}
  Product card. Accepts: product (required).
  Hover swaps to the second image; colour option renders as swatch dots.
{%- endcomment -%}
<article class="card">
  <div class="card-media">
    {%- if product.compare_at_price > product.price -%}
      <span class="badge">Sale</span>
    {%- elsif product.available == false -%}
      <span class="badge badge--soldout">Sold out</span>
    {%- endif -%}

    <a href="{{ product.url }}" aria-label="{{ product.title | escape }}">
      {%- if product.featured_media -%}
        {{ product.featured_media | image_url: width: 800 | image_tag:
          alt: product.title,
          loading: 'lazy',
          sizes: '(max-width: 640px) 50vw, 25vw',
          widths: '360, 540, 800'
        }}
        {%- if settings.card_hover_swap and product.media[1] and product.media[1].media_type == 'image' -%}
          {{ product.media[1] | image_url: width: 800 | image_tag:
            alt: product.title,
            loading: 'lazy',
            class: 'card-img-alt',
            sizes: '(max-width: 640px) 50vw, 25vw',
            widths: '360, 540, 800'
          }}
        {%- endif -%}
      {%- else -%}
        {{ 'product-2' | placeholder_svg_tag }}
      {%- endif -%}
    </a>
  </div>

  <div class="card-info">
    <h3 class="card-name"><a href="{{ product.url }}">{{ product.title }}</a></h3>
    <div class="card-meta">{% render 'price', product: product %}</div>

    {%- if settings.card_show_swatches -%}
      {%- for option in product.options_with_values -%}
        {%- assign opt_down = option.name | downcase -%}
        {%- if opt_down == 'colour' or opt_down == 'color' -%}
          {%- if option.values.size > 1 -%}
            <div class="swatch-row" aria-label="Available colours">
              {%- for value in option.values limit: 6 -%}
                <span class="swatch" data-colour="{{ value | handleize }}" title="{{ value | escape }}"></span>
              {%- endfor -%}
              <span class="swatch-label">{{ option.values.size }} colours</span>
            </div>
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}
  </div>
</article>
