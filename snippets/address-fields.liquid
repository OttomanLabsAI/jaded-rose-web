{%- comment -%} Shared address form fields. Accepts: form (customer_address form). {%- endcomment -%}
<div class="field">
  <label for="AddrFirst_{{ form.id }}">First name</label>
  <input type="text" id="AddrFirst_{{ form.id }}" name="address[first_name]" value="{{ form.first_name }}" autocomplete="given-name">
</div>
<div class="field">
  <label for="AddrLast_{{ form.id }}">Last name</label>
  <input type="text" id="AddrLast_{{ form.id }}" name="address[last_name]" value="{{ form.last_name }}" autocomplete="family-name">
</div>
<div class="field">
  <label for="AddrAddress1_{{ form.id }}">Address</label>
  <input type="text" id="AddrAddress1_{{ form.id }}" name="address[address1]" value="{{ form.address1 }}" autocomplete="address-line1">
</div>
<div class="field">
  <label for="AddrAddress2_{{ form.id }}">Apartment, suite, etc.</label>
  <input type="text" id="AddrAddress2_{{ form.id }}" name="address[address2]" value="{{ form.address2 }}" autocomplete="address-line2">
</div>
<div class="field">
  <label for="AddrCity_{{ form.id }}">City</label>
  <input type="text" id="AddrCity_{{ form.id }}" name="address[city]" value="{{ form.city }}" autocomplete="address-level2">
</div>
<div class="field field--select">
  <label for="AddrCountry_{{ form.id }}">Country/region</label>
  <select
    id="AddrCountry_{{ form.id }}"
    name="address[country]"
    data-default="{{ form.country }}"
    autocomplete="country"
  >
    {{ all_country_option_tags }}
  </select>
</div>
<div class="field">
  <label for="AddrProvince_{{ form.id }}">State/province</label>
  <input type="text" id="AddrProvince_{{ form.id }}" name="address[province]" value="{{ form.province }}" autocomplete="address-level1">
</div>
<div class="field">
  <label for="AddrZip_{{ form.id }}">Postcode</label>
  <input type="text" id="AddrZip_{{ form.id }}" name="address[zip]" value="{{ form.zip }}" autocomplete="postal-code">
</div>
<div class="field">
  <label for="AddrPhone_{{ form.id }}">Phone</label>
  <input type="tel" id="AddrPhone_{{ form.id }}" name="address[phone]" value="{{ form.phone }}" autocomplete="tel">
</div>
<div class="field">
  <label style="display:flex;align-items:center;gap:10px;text-transform:none;letter-spacing:.04em;font-size:13px">
    <input type="checkbox" name="address[default]" style="width:auto" {% if form.default %}checked{% endif %}>
    Set as default address
  </label>
</div>
<script>
  (function () {
    var sel = document.getElementById('AddrCountry_{{ form.id }}');
    if (sel && sel.dataset.default) sel.value = sel.dataset.default;
  })();
</script>
