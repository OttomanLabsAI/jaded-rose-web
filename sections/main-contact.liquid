<div class="account-wrap">
  <p class="eyebrow" style="text-align:center">{{ shop.name }}</p>
  <h1 class="account-title display">{{ page.title | default: 'Contact us' }}</h1>
  {%- if page.content != blank -%}
    <div class="account-sub rte">{{ page.content }}</div>
  {%- endif -%}

  {%- form 'contact' -%}
    {%- if form.posted_successfully? -%}
      <p class="form-status form-status--good">Thank you — we'll be in touch soon.</p>
    {%- elsif form.errors -%}
      <p class="form-status form-status--bad">Please correct the highlighted fields and try again.</p>
    {%- endif -%}

    <div class="field">
      <label for="ContactName">Name</label>
      <input type="text" id="ContactName" name="contact[name]" autocomplete="name" value="{{ form.name }}">
    </div>
    <div class="field">
      <label for="ContactEmail">Email</label>
      <input type="email" id="ContactEmail" name="contact[email]" autocomplete="email" required value="{{ form.email }}">
    </div>
    <div class="field">
      <label for="ContactBody">Message</label>
      <textarea id="ContactBody" name="contact[body]" rows="6" required>{{ form.body }}</textarea>
    </div>
    <button type="submit" class="btn btn--full">Send message</button>
  {%- endform -%}
</div>

{% schema %}
{
  "name": "Contact",
  "settings": []
}
{% endschema %}
