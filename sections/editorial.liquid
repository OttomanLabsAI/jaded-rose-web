<section class="section section--hairline">
  <div class="editorial">
    <div>
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.quote != blank -%}
        <h2 class="editorial-quote display">{{ section.settings.quote }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <p class="body">{{ section.settings.text | escape }}</p>
      {%- endif -%}
      {%- if section.settings.cta_label != blank -%}
        <a class="btn btn--ghost" href="{{ section.settings.cta_link | default: routes.root_url }}">{{ section.settings.cta_label | escape }}</a>
      {%- endif -%}
    </div>
    <div class="edit-tiles">
      {%- for block in section.blocks limit: 2 -%}
        <a class="edit-tile" href="{{ block.settings.link | default: routes.collections_url }}" {{ block.shopify_attributes }}>
          {%- if block.settings.image -%}
            {{ block.settings.image | image_url: width: 900 | image_tag:
              alt: block.settings.caption | default: 'Editorial',
              loading: 'lazy',
              sizes: '(max-width: 1080px) 50vw, 25vw',
              widths: '420, 640, 900'
            }}
          {%- elsif forloop.first -%}
            {%- comment -%} Brand defaults — imagery from the store's CDN {%- endcomment -%}
            <img src="https://jadedrose.co.uk/cdn/shop/files/DALINA-IVORY-1_1200x1200.jpg?v=1753094985" alt="{{ block.settings.caption | escape | default: 'Editorial' }}" width="960" height="1200" loading="lazy">
          {%- else -%}
            <img src="https://jadedrose.co.uk/cdn/shop/files/DAISY-SKIRT-1-jpg_1200x1200.jpg?v=1761830225" alt="{{ block.settings.caption | escape | default: 'Editorial' }}" width="960" height="1200" loading="lazy">
          {%- endif -%}
          {%- if block.settings.caption != blank -%}
            <figcaption>{{ block.settings.caption | escape }}</figcaption>
          {%- endif -%}
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Editorial",
  "max_blocks": 2,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our story" },
    { "type": "richtext", "id": "quote", "label": "Quote", "default": "<p>Born out of the love for high quality, and specially curated looks.</p>" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Jaded Rose brings you sultry and authentic pieces that leave you wanting more." },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "The brand" },
    { "type": "url", "id": "cta_link", "label": "Button link" }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Image tile",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "caption", "label": "Caption" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    { "name": "Editorial", "blocks": [{ "type": "tile" }, { "type": "tile" }] }
  ]
}
{% endschema %}
