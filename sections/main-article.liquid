<article class="article-wrap">
  <p class="eyebrow">{{ blog.title }} · {{ article.published_at | date: '%B %d, %Y' }}</p>
  <h1 class="article-title display">{{ article.title }}</h1>
  {%- if article.image -%}
    <div class="article-hero">
      {{ article.image | image_url: width: 1600 | image_tag: alt: article.title, widths: '750, 1100, 1600' }}
    </div>
  {%- endif -%}
  <div class="rte">{{ article.content }}</div>
</article>

{% schema %}
{
  "name": "Article",
  "settings": []
}
{% endschema %}
