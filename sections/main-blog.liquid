<div class="util-head">
  <p class="eyebrow">{{ shop.name }}</p>
  <h1 class="sec-title display">{{ blog.title }}</h1>
</div>

{%- paginate blog.articles by 12 -%}
  <div class="blog-grid">
    {%- for article in blog.articles -%}
      <a class="post-card" href="{{ article.url }}">
        <div class="card-media">
          {%- if article.image -%}
            {{ article.image | image_url: width: 900 | image_tag: alt: article.title, loading: 'lazy', widths: '420, 640, 900' }}
          {%- else -%}
            {{ 'image' | placeholder_svg_tag }}
          {%- endif -%}
        </div>
        <h3>{{ article.title }}</h3>
        <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | date: '%B %d, %Y' }}</time>
      </a>
    {%- endfor -%}
  </div>

  {%- if paginate.pages > 1 -%}
    <nav class="pagination" aria-label="Pagination">
      {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}">&larr; Prev</a>{%- endif -%}
      {%- if paginate.next -%}<a href="{{ paginate.next.url }}">Next &rarr;</a>{%- endif -%}
    </nav>
  {%- endif -%}
{%- endpaginate -%}

{% schema %}
{
  "name": "Blog",
  "settings": []
}
{% endschema %}
