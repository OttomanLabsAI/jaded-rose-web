{%- liquid
  assign height_class = 'hero--tall'
  if section.settings.height == 'full'
    assign height_class = 'hero--full'
  elsif section.settings.height == 'short'
    assign height_class = 'hero--short'
  endif
-%}

<section class="hero {{ height_class }}">
  <div class="hero-media">
    {%- if section.settings.image -%}
      {{ section.settings.image | image_url: width: 2400 | image_tag:
        alt: section.settings.image.alt | default: section.settings.heading,
        sizes: '100vw',
        widths: '750, 1100, 1600, 2000, 2400',
        fetchpriority: 'high'
      }}
    {%- else -%}
      {%- comment -%} Brand default — Edith burgundy gown from the store's CDN {%- endcomment -%}
      <img
        src="https://jadedrose.co.uk/cdn/shop/files/EDITH-BURGUNDY-4-jpg_1200x1200.jpg?v=1761567143"
        alt="{{ section.settings.heading | escape }}"
        width="960"
        height="1200"
        fetchpriority="high"
      >
    {%- endif -%}
  </div>

  <div class="hero-inner {% if section.settings.align == 'center' %}hero-inner--center{% endif %}">
    {%- if section.settings.eyebrow != blank -%}
      <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h1 class="hero-title display">{{ section.settings.heading | escape }}</h1>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <p class="hero-sub">{{ section.settings.subheading | escape }}</p>
    {%- endif -%}
    <div class="hero-ctas">
      {%- if section.settings.cta_label != blank -%}
        <a class="btn {% if section.settings.image %}btn--light{% endif %}" href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}">
          {{- section.settings.cta_label | escape -}}
        </a>
      {%- endif -%}
      {%- if section.settings.cta2_label != blank -%}
        <a class="btn--line" href="{{ section.settings.cta2_link | default: routes.all_products_collection_url }}">
          {{- section.settings.cta2_label | escape -}}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    {
      "type": "select",
      "id": "height",
      "label": "Height",
      "options": [
        { "value": "full", "label": "Full screen" },
        { "value": "tall", "label": "Tall" },
        { "value": "short", "label": "Short" }
      ],
      "default": "full"
    },
    {
      "type": "select",
      "id": "align",
      "label": "Content position",
      "options": [
        { "value": "left", "label": "Bottom left" },
        { "value": "center", "label": "Centre" }
      ],
      "default": "left"
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Jaded Rose · London" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Timeless design, for the girl who wants it all" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Sultry, structured occasionwear — corseted cottons and floor-sweeping gowns, cut in London for every moment worth dressing for." },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Shop new in" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    { "type": "text", "id": "cta2_label", "label": "Secondary link label", "default": "Explore the sale" },
    { "type": "url", "id": "cta2_link", "label": "Secondary link" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
