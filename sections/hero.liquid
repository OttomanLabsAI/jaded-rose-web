{%- liquid
  assign height_class = 'hero--tall'
  case section.settings.height
    when 'full'
      assign height_class = 'hero--full'
    when 'short'
      assign height_class = 'hero--short'
    when 'fixed'
      assign height_class = 'hero--fixed'
  endcase
-%}

<section
  class="hero {{ height_class }}"
  data-slideshow
  {% if section.settings.autoplay and section.blocks.size > 1 %}data-autoplay="{{ section.settings.autoplay_speed | default: 7 }}"{% endif %}
  role="region"
  aria-label="Slideshow"
>
  {%- if section.blocks.size > 0 -%}
    {%- for block in section.blocks -%}
      {%- liquid
        assign img_loading = 'lazy'
        if forloop.first
          assign img_loading = 'eager'
        endif
        assign pos_style = 'object-position: ' | append: block.settings.image_position | append: ';'
        assign has_copy = false
        if block.settings.subheading != blank or block.settings.title != blank or block.settings.button_label != blank
          assign has_copy = true
        endif
      -%}
      {%- if block.settings.link != blank -%}
        <a href="{{ block.settings.link }}" class="slide{% if forloop.first %} is-on{% endif %}{% unless has_copy %} slide--plain{% endunless %}" data-slide {{ block.shopify_attributes }}>
      {%- else -%}
        <div class="slide{% if forloop.first %} is-on{% endif %}{% unless has_copy %} slide--plain{% endunless %}" data-slide {{ block.shopify_attributes }}>
      {%- endif -%}

        {%- if block.settings.image -%}
          <picture>
            {%- if block.settings.mobile_image -%}
              <source media="(max-width: 749px)" srcset="{{ block.settings.mobile_image | image_url: width: 900 }}">
            {%- endif -%}
            {{ block.settings.image | image_url: width: 2400 | image_tag:
              alt: block.settings.title | default: shop.name,
              sizes: '100vw',
              widths: '750, 1100, 1600, 2000, 2400',
              style: pos_style,
              loading: img_loading
            }}
          </picture>
        {%- else -%}
          {{ 'lifestyle-2' | placeholder_svg_tag: 'slide-placeholder' }}
        {%- endif -%}

        {%- if has_copy -%}
          <div class="slide-copy {% if block.settings.overlay_position == 'bottom' %}slide-copy--bottom{% endif %}">
            {%- if block.settings.subheading != blank -%}
              <p class="eyebrow">{{ block.settings.subheading | escape }}</p>
            {%- endif -%}
            {%- if block.settings.title != blank -%}
              <h2 class="slide-title display">{{ block.settings.title | escape }}</h2>
            {%- endif -%}
            {%- if block.settings.button_label != blank -%}
              <span class="btn btn--outline-light">{{ block.settings.button_label | escape }}</span>
            {%- endif -%}
          </div>
        {%- endif -%}

      {%- if block.settings.link != blank -%}</a>{%- else -%}</div>{%- endif -%}
    {%- endfor -%}

    {%- if section.blocks.size > 1 and section.settings.show_dots -%}
      <div class="hero-dots" data-slide-dots></div>
    {%- endif -%}
  {%- else -%}
    {%- comment -%} No slides configured — brand default from the store's CDN {%- endcomment -%}
    <div class="slide is-on slide--plain">
      <img
        src="https://jadedrose.co.uk/cdn/shop/files/EDITH-BURGUNDY-4-jpg_1200x1200.jpg?v=1761567143"
        alt="{{ shop.name | escape }}"
        width="960"
        height="1200"
        style="object-position: center top;"
        fetchpriority="high"
      >
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Slideshow",
  "max_blocks": 5,
  "settings": [
    {
      "type": "select",
      "id": "height",
      "label": "Height",
      "options": [
        { "value": "full", "label": "Full screen" },
        { "value": "tall", "label": "Tall" },
        { "value": "fixed", "label": "Fixed band" },
        { "value": "short", "label": "Short" }
      ],
      "default": "full"
    },
    { "type": "checkbox", "id": "autoplay", "label": "Auto-rotate slides", "default": true },
    {
      "type": "range",
      "id": "autoplay_speed",
      "min": 4,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Change slides every",
      "default": 7
    },
    { "type": "checkbox", "id": "show_dots", "label": "Show dot navigation", "default": true }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "image_picker", "id": "mobile_image", "label": "Mobile image (optional)" },
        {
          "type": "select",
          "id": "image_position",
          "label": "Image focal point",
          "options": [
            { "value": "center top", "label": "Top" },
            { "value": "center center", "label": "Centre" },
            { "value": "center bottom", "label": "Bottom" }
          ],
          "default": "center center"
        },
        { "type": "text", "id": "subheading", "label": "Subheading" },
        { "type": "text", "id": "title", "label": "Heading" },
        { "type": "text", "id": "button_label", "label": "Button label" },
        { "type": "url", "id": "link", "label": "Link" },
        {
          "type": "select",
          "id": "overlay_position",
          "label": "Text position",
          "options": [
            { "value": "center", "label": "Centre" },
            { "value": "bottom", "label": "Bottom" }
          ],
          "default": "center"
        }
      ]
    }
  ],
  "presets": [
    { "name": "Slideshow", "blocks": [{ "type": "slide" }] }
  ]
}
{% endschema %}
