<section class="section">
  <div class="sec-head">
    <div>
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="sec-title display">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
    </div>
    {%- if section.settings.link_label != blank -%}
      <a class="sec-link" href="{{ section.settings.link | default: routes.collections_url }}">{{ section.settings.link_label | escape }}</a>
    {%- endif -%}
  </div>

  <div class="rail">
    {%- for block in section.blocks -%}
      {%- assign coll = block.settings.collection -%}
      <a
        class="rail-item"
        href="{{ coll.url | default: routes.collections_url }}"
        {{ block.shopify_attributes }}
      >
        <div class="rail-frame">
          {%- assign rail_image = block.settings.image | default: coll.featured_image -%}
          {%- if rail_image -%}
            {{ rail_image | image_url: width: 800 | image_tag:
              alt: coll.title | default: block.settings.title,
              loading: 'lazy',
              sizes: '(max-width: 640px) 60vw, 25vw',
              widths: '360, 540, 800'
            }}
          {%- else -%}
            {{ 'collection-1' | placeholder_svg_tag: 'rail-placeholder' }}
          {%- endif -%}
        </div>
        <span class="rail-name">{{ block.settings.title | default: coll.title | default: 'Collection' }}</span>
      </a>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Collection rail",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Shop by occasion" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Dressed for the moment" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Shop everything" },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "image_picker", "id": "image", "label": "Custom image (optional)" },
        { "type": "text", "id": "title", "label": "Custom title (optional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection rail",
      "blocks": [
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" }
      ]
    }
  ]
}
{% endschema %}
