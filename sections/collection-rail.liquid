<section class="section">
  <div class="sec-head">
    <div>
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="sec-title display">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
    </div>
    {%- if section.settings.link_label != blank -%}
      <a class="sec-link" href="{{ section.settings.link | default: routes.collections_url }}">{{ section.settings.link_label | escape }}</a>
    {%- endif -%}
  </div>

  {%- liquid
    # Manual mode when at least one block has a collection assigned;
    # otherwise auto-fill from the store's non-empty collections.
    assign has_assigned = false
    for block in section.blocks
      if block.settings.collection != blank
        assign has_assigned = true
      endif
    endfor
  -%}

  <div class="rail">
    {%- if has_assigned -%}
      {%- for block in section.blocks -%}
        {%- assign coll = block.settings.collection -%}
        {%- if coll == blank -%}{%- continue -%}{%- endif -%}
        <a class="rail-item" href="{{ coll.url }}" {{ block.shopify_attributes }}>
          <div class="rail-frame">
            {%- assign rail_image = block.settings.image | default: coll.featured_image -%}
            {%- if rail_image -%}
              {{ rail_image | image_url: width: 800 | image_tag:
                alt: coll.title,
                loading: 'lazy',
                sizes: '(max-width: 640px) 60vw, 25vw',
                widths: '360, 540, 800'
              }}
            {%- else -%}
              {{ 'collection-1' | placeholder_svg_tag: 'rail-placeholder' }}
            {%- endif -%}
          </div>
          <span class="rail-name">{{ block.settings.title | default: coll.title }}</span>
        </a>
      {%- endfor -%}
    {%- else -%}
      {%- assign shown = 0 -%}
      {%- for coll in collections -%}
        {%- if coll.handle == 'frontpage' or coll.products_count == 0 -%}{%- continue -%}{%- endif -%}
        {%- if shown >= section.settings.auto_limit -%}{%- break -%}{%- endif -%}
        {%- assign shown = shown | plus: 1 -%}
        <a class="rail-item" href="{{ coll.url }}">
          <div class="rail-frame">
            {%- assign rail_image = coll.featured_image | default: coll.products.first.featured_media -%}
            {%- if rail_image -%}
              {{ rail_image | image_url: width: 800 | image_tag:
                alt: coll.title,
                loading: 'lazy',
                sizes: '(max-width: 640px) 60vw, 25vw',
                widths: '360, 540, 800'
              }}
            {%- else -%}
              {{ 'collection-1' | placeholder_svg_tag: 'rail-placeholder' }}
            {%- endif -%}
          </div>
          <span class="rail-name">{{ coll.title }}</span>
        </a>
      {%- endfor -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Collection rail",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Shop by occasion" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Dressed for the moment" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Shop everything" },
    { "type": "url", "id": "link", "label": "Link" },
    {
      "type": "range",
      "id": "auto_limit",
      "min": 3,
      "max": 8,
      "step": 1,
      "label": "Collections shown when auto-filling",
      "default": 6,
      "info": "Used when no collections are assigned to blocks — the rail fills itself with your store's non-empty collections."
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "image_picker", "id": "image", "label": "Custom image (optional)" },
        { "type": "text", "id": "title", "label": "Custom title (optional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection rail",
      "blocks": [
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" }
      ]
    }
  ]
}
{% endschema %}
