{%- liquid
  assign height_class = 'hero--tall'
  case section.settings.height
    when 'full'
      assign height_class = 'hero--full'
    when 'short'
      assign height_class = 'hero--short'
    when 'fixed'
      assign height_class = 'hero--fixed'
  endcase
  assign pos_style = 'object-position: ' | append: section.settings.image_position | append: ';'
-%}

<section class="hero {{ height_class }}">
  {%- if section.settings.link != blank -%}
    <a href="{{ section.settings.link }}" class="slide is-on slide--plain" aria-label="{{ section.settings.alt_text | default: shop.name | escape }}">
  {%- else -%}
    <div class="slide is-on slide--plain">
  {%- endif -%}

    {%- if section.settings.image -%}
      <picture>
        {%- if section.settings.mobile_image -%}
          <source media="(max-width: 749px)" srcset="{{ section.settings.mobile_image | image_url: width: 900 }}">
        {%- endif -%}
        {{ section.settings.image | image_url: width: 2400 | image_tag:
          alt: section.settings.alt_text | default: shop.name,
          sizes: '100vw',
          widths: '750, 1100, 1600, 2000, 2400',
          style: pos_style,
          loading: 'lazy'
        }}
      </picture>
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'slide-placeholder' }}
    {%- endif -%}

  {%- if section.settings.link != blank -%}</a>{%- else -%}</div>{%- endif -%}
</section>

{% schema %}
{
  "name": "Image banner",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "image_picker", "id": "mobile_image", "label": "Mobile image (optional)" },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image focal point",
      "options": [
        { "value": "center top", "label": "Top" },
        { "value": "center center", "label": "Centre" },
        { "value": "center bottom", "label": "Bottom" }
      ],
      "default": "center center"
    },
    {
      "type": "select",
      "id": "height",
      "label": "Height",
      "options": [
        { "value": "full", "label": "Full screen" },
        { "value": "tall", "label": "Tall" },
        { "value": "fixed", "label": "Fixed band" },
        { "value": "short", "label": "Short" }
      ],
      "default": "full"
    },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "text", "id": "alt_text", "label": "Image description (alt text)" }
  ],
  "presets": [{ "name": "Image banner" }]
}
{% endschema %}
