<section class="section {% if section.settings.tint %}section--porcelain section--hairline{% endif %}">
  <div class="sec-head">
    <div>
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="sec-title display">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
    </div>
    <a class="sec-link" href="{{ section.settings.collection.url | default: routes.all_products_collection_url }}">View all</a>
  </div>

  {%- liquid
    # Fall back to the automatic “All products” collection when none is assigned,
    # so the grid populates itself on a fresh install.
    assign source = section.settings.collection
    if source == blank
      assign source = collections['all']
    endif
  -%}
  <div class="grid">
    {%- if source.products.size > 0 -%}
      {%- for product in source.products limit: section.settings.limit -%}
        {% render 'product-card', product: product %}
      {%- endfor -%}
    {%- else -%}
      {%- for i in (1..section.settings.limit) -%}
        <div class="card">
          <div class="card-media">{{ 'product-1' | placeholder_svg_tag }}</div>
          <div class="card-info">
            <h3 class="card-name">Example product</h3>
            <div class="card-meta"><span class="price">£75.00</span></div>
          </div>
        </div>
      {%- endfor -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Best sellers" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your favourites" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    {
      "type": "range",
      "id": "limit",
      "min": 4,
      "max": 12,
      "step": 4,
      "label": "Products shown",
      "default": 8
    },
    { "type": "checkbox", "id": "tint", "label": "Porcelain background", "default": true }
  ],
  "presets": [{ "name": "Featured collection" }]
}
{% endschema %}
