[
  {
    "name": "theme_info",
    "theme_name": "Jaded Rose",
    "theme_version": "2.0.0",
    "theme_author": "Jaded Rose",
    "theme_documentation_url": "https://github.com/OttomanLabsAI/jaded-rose-web",
    "theme_support_url": "https://github.com/OttomanLabsAI/jaded-rose-web/issues"
  },
  {
    "name": "Brand",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo"
      },
      {
        "type": "range",
        "id": "logo_width",
        "min": 60,
        "max": 300,
        "step": 10,
        "unit": "px",
        "label": "Logo width",
        "default": 140
      }
    ]
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "color",
        "id": "color_background",
        "label": "Background",
        "default": "#FFFFFF"
      },
      {
        "type": "color",
        "id": "color_secondary_background",
        "label": "Secondary background",
        "default": "#F8F7F7"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "Text",
        "default": "#212121"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Accent",
        "default": "#540016"
      }
    ]
  },
  {
    "name": "Social media",
    "settings": [
      {
        "type": "text",
        "id": "social_instagram",
        "label": "Instagram URL"
      },
      {
        "type": "text",
        "id": "social_tiktok",
        "label": "TikTok URL"
      },
      {
        "type": "text",
        "id": "social_twitter",
        "label": "X / Twitter URL"
      },
      {
        "type": "text",
        "id": "social_facebook",
        "label": "Facebook URL"
      }
    ]
  },
  {
    "name": "Product cards",
    "settings": [
      {
        "type": "checkbox",
        "id": "card_hover_swap",
        "label": "Show second image on hover",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "card_show_swatches",
        "label": "Show colour swatches",
        "default": true
      }
    ]
  }
]
